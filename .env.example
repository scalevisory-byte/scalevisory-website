# The site is a static export with no backend — these are all optional and
# only affect third-party widgets. Copy to .env.local for local development.

# Canonical site URL (used for canonicals, sitemap.xml, robots.txt, JSON-LD).
# The deploy workflow sets this itself, so you only need it locally.
NEXT_PUBLIC_SITE_URL=https://scalevisory.in

# Google Analytics 4 (optional) — leave blank to load no analytics at all.
NEXT_PUBLIC_GA_ID=

# tawk.to chat widget (optional) — from tawk.to > Administration > Chat Widget,
# the embed URL looks like embed.tawk.to/<PROPERTY>/<WIDGET>
NEXT_PUBLIC_TAWK_PROPERTY_ID=
NEXT_PUBLIC_TAWK_WIDGET_ID=default
